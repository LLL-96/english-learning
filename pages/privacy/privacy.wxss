.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

.privacy-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  text-align: center;
  margin-bottom: 40rpx;
  padding-bottom: 30rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 20rpx;
}

.section-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
  display: block;
  white-space: pre-line;
}

.update-time {
  text-align: center;
  font-size: 24rpx;
  color: #999;
  margin-top: 40rpx;
  padding-top: 30rpx;
  border-top: 2rpx solid #f0f0f0;
}
