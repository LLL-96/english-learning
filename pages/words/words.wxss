.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 年级选择 */
.grade-bar {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.grade-scroll {
  white-space: nowrap;
}

.grade-list {
  display: inline-flex;
  padding: 0 20rpx;
}

.grade-item {
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
}

.grade-item.active {
  background: #667eea;
  color: #fff;
}

/* 单元选择 */
.unit-bar {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.unit-scroll {
  white-space: nowrap;
}

.unit-list {
  display: inline-flex;
  padding: 0 20rpx;
}

.unit-item {
  padding: 12rpx 28rpx;
  margin-right: 16rpx;
  background: #f0f0f0;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.unit-item.active {
  background: #52c41a;
  color: #fff;
}

/* 进度条 */
.progress-section {
  background: #fff;
  padding: 20rpx 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.study-count {
  color: #667eea;
  font-weight: 500;
}

.progress-bar {
  background: #e8e8e8;
  height: 12rpx;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  background: linear-gradient(90deg, #667eea, #764ba2);
  height: 100%;
  border-radius: 6rpx;
  transition: width 0.3s;
}

/* 单词卡片 */
.word-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(102, 126, 234, 0.3);
  position: relative;
}

/* 收藏按钮 */
.favorite-btn {
  position: absolute;
  top: 30rpx;
  right: 30rpx;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.favorite-icon {
  font-size: 36rpx;
  color: #ffd700;
}

/* 掌握程度 */
.mastery-level {
  position: absolute;
  top: 30rpx;
  left: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.mastery-stars {
  font-size: 28rpx;
  color: #ffd700;
  letter-spacing: 4rpx;
}

.mastery-text {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 4rpx;
}

.word-main {
  text-align: center;
  margin-bottom: 40rpx;
}

.word-en {
  display: block;
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.word-phonetic {
  display: block;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-bottom: 20rpx;
}

.word-cn {
  display: block;
  font-size: 48rpx;
  color: #fff;
  font-weight: 500;
}

/* 例句 */
.example-section {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.example-line {
  height: 2rpx;
  background: rgba(255, 255, 255, 0.3);
  margin-bottom: 20rpx;
}

.example-en {
  display: block;
  font-size: 30rpx;
  color: #fff;
  margin-bottom: 10rpx;
}

.example-cn {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 操作按钮 */
.action-btns {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}

.btn-speak {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  padding: 20rpx 40rpx;
  background: #52c41a;
  color: #fff;
  border-radius: 50rpx;
  font-size: 28rpx;
  border: none;
}

.btn-speak::after {
  border: none;
}

.btn-example {
  background: #faad14;
}

.btn-icon {
  font-size: 32rpx;
}

/* 导航按钮 */
.nav-section {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.nav-btn {
  flex: 1;
  padding: 24rpx;
  background: #667eea;
  color: #fff;
  border-radius: 50rpx;
  font-size: 30rpx;
  text-align: center;
  border: none;
}

.nav-btn::after {
  border: none;
}

.nav-btn.disabled {
  background: #ccc;
}

/* 单词列表 */
.word-list-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #667eea;
}

.word-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.word-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.word-item.active {
  background: #e6f7ff;
  border: 2rpx solid #667eea;
}

.item-en {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.item-cn {
  flex: 1;
  font-size: 28rpx;
  color: #666;
  text-align: right;
  padding-right: 20rpx;
}

.item-play {
  font-size: 36rpx;
  padding: 10rpx;
}
