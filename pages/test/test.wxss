.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 统计栏 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 测试卡片 */
.test-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
}

.question-section {
  text-align: center;
  margin-bottom: 40rpx;
}

.question-title {
  display: block;
  font-size: 32rpx;
  color: #333;
  margin-bottom: 30rpx;
}

.btn-listen {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 30rpx 60rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  border: none;
  box-shadow: 0 8rpx 30rpx rgba(102, 126, 234, 0.3);
}

.btn-listen::after {
  border: none;
}

.listen-icon {
  font-size: 40rpx;
}

/* 选项 */
.options-section {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-btn {
  width: 100%;
  padding: 30rpx;
  background: #f8f8f8;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333;
  text-align: left;
}

.option-btn::after {
  border: none;
}

.option-btn.correct {
  background: #f6ffed;
  border-color: #52c41a;
  color: #52c41a;
}

.option-btn.wrong {
  background: #fff1f0;
  border-color: #ff4d4f;
  color: #ff4d4f;
}

/* 反馈区域 */
.feedback-section {
  margin-top: 40rpx;
  text-align: center;
}

.feedback {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.feedback-icon {
  font-size: 48rpx;
}

.feedback-text {
  font-size: 36rpx;
  font-weight: bold;
}

.feedback.correct {
  color: #52c41a;
}

.feedback.wrong {
  color: #ff4d4f;
}

.correct-answer {
  background: #f8f8f8;
  padding: 20rpx;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.correct-answer text {
  display: block;
  font-size: 30rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.word-detail {
  color: #667eea !important;
  font-weight: 500;
}

.btn-next {
  width: 100%;
  padding: 24rpx;
  background: #667eea;
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  border: none;
}

.btn-next::after {
  border: none;
}

/* 结果卡片 */
.result-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 20rpx;
}

.result-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.result-title {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 30rpx;
}

.result-score {
  margin-bottom: 30rpx;
}

.score-num {
  font-size: 80rpx;
  font-weight: bold;
  color: #667eea;
}

.score-total {
  font-size: 40rpx;
  color: #999;
}

.result-detail {
  margin-bottom: 40rpx;
}

.result-detail text {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 10rpx;
}

.result-actions {
  display: flex;
  gap: 20rpx;
}

.btn-restart {
  flex: 1;
  padding: 24rpx;
  background: #52c41a;
  color: #fff;
  border-radius: 50rpx;
  font-size: 30rpx;
  border: none;
}

.btn-restart::after {
  border: none;
}

.btn-back {
  flex: 1;
  padding: 24rpx;
  background: #f0f0f0;
  color: #666;
  border-radius: 50rpx;
  font-size: 30rpx;
  border: none;
}

.btn-back::after {
  border: none;
}

/* 设置区域 */
.settings-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #667eea;
}

.setting-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.setting-item:last-child {
  border-bottom: none;
}

.setting-item text {
  font-size: 30rpx;
  color: #666;
}

.picker-value {
  font-size: 30rpx;
  color: #667eea;
  font-weight: 500;
}
