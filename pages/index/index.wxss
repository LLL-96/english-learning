.container {
  padding: 30rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 头部横幅 */
.header-banner {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-shadow: 0 10rpx 40rpx rgba(102, 126, 234, 0.3);
}

.welcome-text {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}

.sub-text {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* 区块样式 */
.section {
  margin-bottom: 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #667eea;
}

/* 年级选择 */
.grade-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  background: #fff;
  padding: 30rpx;
  border-radius: 20rpx;
}

.grade-btn {
  padding: 16rpx 32rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.grade-btn.active {
  background: #667eea;
  color: #fff;
}

/* 功能入口 */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.feature-item {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.feature-icon {
  font-size: 60rpx;
  margin-bottom: 16rpx;
}

.feature-text {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 统计卡片 */
.stats-card {
  display: flex;
  justify-content: space-around;
  background: #fff;
  padding: 40rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.05);
}

.achievement-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.achievement-card .stat-num {
  color: #fff;
}

.achievement-card .stat-label {
  color: rgba(255, 255, 255, 0.8);
}

.stat-item {
  text-align: center;
}

.stat-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #999;
}

/* 开始按钮 */
.start-btn {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  font-size: 36rpx;
  font-weight: bold;
}

/* 提示卡片 */
.tips-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-top: 20rpx;
}

.tips-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.tips-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.tip-item {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 免责声明 */
.disclaimer-card {
  background: #fffbeb;
  border: 2rpx solid #f59e0b;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-top: 20rpx;
}

.disclaimer-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #d97706;
  margin-bottom: 12rpx;
}

.disclaimer-text {
  font-size: 24rpx;
  color: #92400e;
  line-height: 1.6;
  display: block;
}

/* 隐私政策链接 */
.privacy-link {
  text-align: center;
  padding: 30rpx;
  margin-top: 10rpx;
}

.privacy-link text {
  font-size: 28rpx;
  color: #667eea;
  text-decoration: underline;
}
