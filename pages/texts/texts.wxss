.container {
  padding: 20rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 年级选择 */
.grade-bar {
  background: #fff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.grade-scroll {
  white-space: nowrap;
}

.grade-list {
  display: inline-flex;
  padding: 0 20rpx;
}

.grade-item {
  padding: 12rpx 24rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  white-space: nowrap;
}

.grade-item.active {
  background: #667eea;
  color: #fff;
}

/* 单元选择 */
.unit-section {
  background: #fff;
  padding: 20rpx 30rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
}

.picker-text {
  font-size: 32rpx;
  color: #333;
  font-weight: 500;
}

.picker-arrow {
  font-size: 24rpx;
  color: #999;
}

/* 课文内容 */
.text-content {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
}

.text-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #667eea;
  text-align: center;
  margin-bottom: 30rpx;
  padding-bottom: 20rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

/* 对话列表 */
.dialog-list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.dialog-item {
  background: #f8f8f8;
  border-radius: 16rpx;
  padding: 30rpx;
  border-left: 8rpx solid #667eea;
}

.dialog-en {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
  line-height: 1.5;
}

.dialog-cn {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  line-height: 1.4;
}

.dialog-actions {
  display: flex;
  justify-content: flex-end;
}

.btn-play {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  background: #52c41a;
  color: #fff;
  border-radius: 30rpx;
  font-size: 26rpx;
  border: none;
}

.btn-play::after {
  border: none;
}

/* 全文朗读按钮 */
.btn-full-read {
  width: 100%;
  margin-top: 40rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50rpx;
  font-size: 32rpx;
  text-align: center;
  border: none;
}

.btn-full-read::after {
  border: none;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 40rpx;
  background: #fff;
  border-radius: 20rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #999;
}
