/* 全局样式 */
page {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Helvetica Neue', Arial, sans-serif;
  background-color: #f5f5f5;
  color: #333;
}

.container {
  padding: 20rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.1);
}

/* 按钮样式 */
.btn-primary {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx 60rpx;
  font-size: 32rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #f0f0f0;
  color: #666;
  border-radius: 50rpx;
  padding: 20rpx 40rpx;
  font-size: 28rpx;
  border: none;
}

.btn-speak {
  background: #52c41a;
  color: #fff;
  border-radius: 50rpx;
  padding: 16rpx 40rpx;
  font-size: 28rpx;
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
}

/* 年级选择器 */
.grade-selector {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx;
}

.grade-btn {
  padding: 16rpx 32rpx;
  border: 2rpx solid #667eea;
  background: #fff;
  color: #667eea;
  border-radius: 40rpx;
  font-size: 28rpx;
  transition: all 0.3s;
}

.grade-btn.active {
  background: #667eea;
  color: #fff;
}

/* 单词卡片 */
.word-card {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 30rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  color: #fff;
  margin-bottom: 40rpx;
}

.word-english {
  font-size: 72rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.word-phonetic {
  font-size: 36rpx;
  opacity: 0.9;
  margin-bottom: 30rpx;
}

.word-chinese {
  font-size: 48rpx;
  font-weight: 500;
}

/* 进度条 */
.progress-bar {
  background: #e8e8e8;
  height: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.progress-fill {
  background: linear-gradient(90deg, #667eea, #764ba2);
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.3s;
}

/* 导航按钮 */
.nav-btns {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.nav-btn {
  flex: 1;
  background: #667eea;
  color: #fff;
  border-radius: 50rpx;
  padding: 24rpx;
  font-size: 30rpx;
  text-align: center;
}

/* 单元选择 */
.unit-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 20rpx;
}

.unit-btn {
  padding: 12rpx 24rpx;
  background: #f0f0f0;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
}

.unit-btn.active {
  background: #667eea;
  color: #fff;
}

/* 测试选项 */
.option-btn {
  width: 100%;
  padding: 30rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  font-size: 32rpx;
  text-align: left;
}

.option-btn.correct {
  background: #f6ffed;
  border-color: #52c41a;
  color: #52c41a;
}

.option-btn.wrong {
  background: #fff1f0;
  border-color: #ff4d4f;
  color: #ff4d4f;
}

/* 统计信息 */
.stats-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #667eea;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

/* 课文样式 */
.text-item {
  background: #fff;
  padding: 30rpx;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
}

.text-english {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 10rpx;
}

.text-chinese {
  font-size: 28rpx;
  color: #666;
}

/* 标题样式 */
.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 20rpx;
  border-left: 8rpx solid #667eea;
}
